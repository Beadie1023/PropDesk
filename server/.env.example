# MetaApi credentials — these stay server-side ONLY. Never prefix these
# with VITE_ or put them in the frontend; Vite bundles VITE_ vars into
# public client JS, which would expose live trading credentials to anyone
# who loads the deployed site.
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here

# Shared secret every request must present via the x-api-key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match VITE_METAAPI_API_KEY on the frontend exactly.
METAAPI_API_KEY=your_generated_api_key_here

# Comma-separated list of IP addresses allowed to reach this API at all —
# checked before the API key, so an unlisted IP is rejected first. No
# spaces required around commas (they're trimmed), e.g.:
# ALLOWED_IPS=203.0.113.10,203.0.113.11,198.51.100.4
# Leave unset to reject every request (fails closed, not open).
ALLOWED_IPS=

# Gemini API key for the AI Market Advisor. Free tier, no credit card —
# get one at https://aistudio.google.com/apikey. Stays server-side only,
# same reasoning as the MetaApi token above.
GEMINI_API_KEY=your_gemini_api_key_here

# Port this backend listens on.
PORT=4000

# Origin allowed to call this API (your deployed/dev frontend URL).
CLIENT_ORIGIN=http://localhost:5173
